{
  "manifest_version": 2,
  "name": "PhishGuard AI - Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time phishing detection and protection powered by AI.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webNavigation",
    "notifications"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  }
}
