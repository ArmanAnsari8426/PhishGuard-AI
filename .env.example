# PhishGuard AI - Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
# SQLite (Development)
DATABASE_URL=sqlite:///database/phishguard.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/phishguard

# API Keys
VIRUSTOTAL_API_KEY=your-virustotal-api-key
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-api-key
PHISHTANK_API_KEY=your-phishtank-api-key

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# Rate Limiting
RATELIMIT_DEFAULT=200 per day, 50 per hour

# File Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ML Model
MODEL_PATH=model/phishing_model.pkl

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/phishguard.log

# Server Configuration
HOST=0.0.0.0
PORT=5000

# CORS
CORS_ORIGINS=*

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:5173
